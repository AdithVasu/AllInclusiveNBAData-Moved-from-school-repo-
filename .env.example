# Core AWS configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3 bucket configuration
NBA_BRONZE_BUCKET=nba-pipeline-bronze
NBA_SILVER_BUCKET=nba-pipeline-silver

# Redshift / PostgreSQL configuration
REDSHIFT_POSTGRES_URL=postgresql+psycopg2://username:password@redshift-cluster-endpoint:5439/dev?sslmode=require
PLAY_BY_PLAY_TABLE=play_by_play
PANDAS_CHUNKSIZE=10000

# Pipeline metadata
PIPELINE_VERSION=2026.09.12

# Optional Airflow runtime settings
AIRFLOW_HOME=
